{%- liquid
  assign heading = section.settings.heading
  assign review_count = section.settings.review_count
  assign header_rating = section.settings.header_rating | plus: 0
-%}

<div
  class="social-proof-reviews color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="social-proof-reviews__wrapper {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="social-proof-reviews__header">
      {%- if heading != blank -%}
        <div class="social-proof-reviews__heading">
          {{ heading }}
        </div>
      {%- endif -%}

      <div class="social-proof-reviews__rating-row">
        <span class="social-proof-reviews__stars social-proof-reviews__stars--header">
          {%- render 'star-rating-icons', rating: header_rating, color: '#BC0F0F', size: 20, half_variant: 'left' -%}
        </span>
        {%- if review_count != blank -%}
          <span class="social-proof-reviews__review-count">{{ review_count | escape }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="social-proof-reviews__carousel">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'image-review' -%}
            <div class="social-proof-reviews__card social-proof-reviews__card--image" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign img = block.settings.image
                  assign sizes_val = '(min-width: 990px) 280px, 280px'
                -%}
                {{
                  img
                  | image_url: width: img.width
                  | image_tag:
                    sizes: sizes_val,
                    widths: '280,420,560',
                    loading: 'lazy',
                    class: 'social-proof-reviews__card-image',
                    alt: img.alt
                }}
              {%- endif -%}
              <div class="social-proof-reviews__card-gradient"></div>
              <div class="social-proof-reviews__card-overlay-text">
                {%- if block.settings.quote != blank -%}
                  <p class="social-proof-reviews__card-quote social-proof-reviews__card-quote--white">
                    {{ block.settings.quote | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="social-proof-reviews__card-author social-proof-reviews__card-author--white">
                    {{ block.settings.author | escape }}
                  </p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'text-review' -%}
            {%- assign card_rating = block.settings.rating | plus: 0 -%}
            <div class="social-proof-reviews__card social-proof-reviews__card--text" {{ block.shopify_attributes }}>
              <div class="social-proof-reviews__card-content">
                <span class="social-proof-reviews__stars social-proof-reviews__stars--card">
                  {%- render 'star-rating-icons', rating: card_rating, color: '#414141', size: 20, half_variant: 'alt' -%}
                </span>
                {%- if block.settings.quote != blank -%}
                  <p class="social-proof-reviews__card-quote social-proof-reviews__card-quote--dark">
                    {{ block.settings.quote | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="social-proof-reviews__card-body">
                    {{ block.settings.body | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="social-proof-reviews__card-author social-proof-reviews__card-author--dark">
                    {{ block.settings.author | escape }}
                  </p>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.social-proof-reviews {
  padding-block-start: var(--padding-block-start);
  padding-block-end: var(--padding-block-end);
}

.social-proof-reviews__wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

.social-proof-reviews__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding-inline: 32px;
  text-align: center;
  max-width: 1200px;
  width: 100%;
}

.social-proof-reviews__heading {
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 48px;
  line-height: 52px;
  letter-spacing: 0;
  text-align: center;
  color: #767676;
}

.social-proof-reviews__heading p {
  margin: 0;
}

.social-proof-reviews__heading strong,
.social-proof-reviews__heading b {
  color: #000000;
}

.social-proof-reviews__rating-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.social-proof-reviews__stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0;
  line-height: 0;
}

.social-proof-reviews__review-count {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -0.5px;
  color: #767676;
}

.social-proof-reviews__carousel {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20px;
  width: 100%;
  max-width: 1200px;
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.social-proof-reviews__carousel::-webkit-scrollbar {
  display: none;
}

.social-proof-reviews__card {
  min-width: 280px;
  width: 280px;
  height: 420px;
  border-radius: 16px;
  overflow: hidden;
  flex-shrink: 0;
}

/* Image review card */
.social-proof-reviews__card--image {
  position: relative;
}

.social-proof-reviews__card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.social-proof-reviews__card-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 30%, rgba(0, 0, 0, 0.55) 100%);
  pointer-events: none;
}

.social-proof-reviews__card-overlay-text {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  width: 215px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.social-proof-reviews__card-quote--white {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 28px;
  line-height: 40px;
  letter-spacing: -1px;
  color: #FFFFFF;
  text-align: center;
  margin: 0;
}

.social-proof-reviews__card-author--white {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 28px;
  line-height: 40px;
  letter-spacing: -1px;
  color: #FFFFFF;
  text-align: center;
  margin: 0;
}

/* Text review card */
.social-proof-reviews__card--text {
  background: #FFFFFF;
}

.social-proof-reviews__card-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 12px 20px;
  height: 100%;
  text-align: center;
}

.social-proof-reviews__card-quote--dark {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 28px;
  line-height: 32px;
  letter-spacing: -1px;
  color: #414141;
  text-align: center;
  margin: 0;
}

.social-proof-reviews__card-body {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -0.5px;
  color: #767676;
  text-align: center;
  margin: 0;
}

.social-proof-reviews__card-author--dark {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 18px;
  line-height: 24px;
  letter-spacing: -0.5px;
  color: #767676;
  text-align: center;
  margin: 0;
}

/* Mobile styles */
@media screen and (max-width: 749px) {
  .social-proof-reviews__wrapper {
    gap: 16px;
  }

  .social-proof-reviews__header {
    align-items: center;
    text-align: center;
    padding-inline: 32px;
    padding-block: 16px;
  }

  .social-proof-reviews__heading {
    font-size: 48px;
    line-height: 36px;
    text-align: center;
  }

  .social-proof-reviews__review-count {
    font-size: 16px;
    line-height: 20px;
  }

  .social-proof-reviews__carousel {
    gap: 16px;
    padding-inline: 12px;
    scroll-snap-type: x mandatory;
  }

  .social-proof-reviews__card {
    scroll-snap-align: start;
  }

  .social-proof-reviews__card--text {
    background: #F5F5F5;
  }

  .social-proof-reviews__card-quote--white {
    font-size: 24px;
    line-height: 32px;
  }

  .social-proof-reviews__card-author--white {
    font-size: 24px;
    line-height: 32px;
  }

  .social-proof-reviews__card-quote--dark {
    font-size: 24px;
    line-height: 32px;
  }

  .social-proof-reviews__card-body {
    font-size: 16px;
    line-height: 20px;
  }

  .social-proof-reviews__card-author--dark {
    font-size: 16px;
    line-height: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.social_proof_reviews",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Join <strong>millions of people</strong> prioritizing their cardiovascular health</p>"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "100K+ verified reviews"
    },
    {
      "type": "select",
      "id": "header_rating",
      "label": "Header star rating",
      "options": [
        { "value": "5", "label": "5 stars" },
        { "value": "4.5", "label": "4.5 stars" },
        { "value": "4", "label": "4 stars" },
        { "value": "3.5", "label": "3.5 stars" },
        { "value": "3", "label": "3 stars" }
      ],
      "default": "4.5"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image-review",
      "name": "Image review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    },
    {
      "type": "text-review",
      "name": "Text review",
      "settings": [
        {
          "type": "select",
          "id": "rating",
          "label": "Star rating",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4.5", "label": "4.5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3.5", "label": "3.5 stars" }
          ],
          "default": "4.5"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.social_proof_reviews"
    }
  ]
}
{% endschema %}
