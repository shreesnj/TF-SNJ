{%- liquid
  assign heading = section.settings.heading
  assign placeholder_text = section.settings.placeholder_text
  assign button_text = section.settings.button_text
  assign search_url = section.settings.search_url | default: routes.search_url
  assign expert_image = section.settings.expert_image
  assign expert_title = section.settings.expert_title
  assign expert_description = section.settings.expert_description
-%}

<div
  class="ask-me color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="ask-me__wrapper {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="ask-me__container">
      <div class="ask-me__search-area">
        {%- if heading != blank -%}
          <h2 class="ask-me__heading">{{ heading | escape }}</h2>
        {%- endif -%}

        <form class="ask-me__field" action="{{ search_url }}" method="get" role="search">
          <div class="ask-me__field-inner">
            <div class="ask-me__field-content">
              <img
                class="ask-me__field-icon"
                src="{{ 'book-open-solid.svg' | asset_url }}"
                alt=""
                width="28"
                height="28"
                loading="lazy"
              >
              <input
                class="ask-me__field-input"
                type="text"
                name="q"
                placeholder="{{ placeholder_text | escape }}"
                aria-label="{{ heading | escape }}"
                autocomplete="off"
              >
            </div>
            <button class="ask-me__field-button" type="submit">
              {{ button_text | escape }}
            </button>
          </div>
        </form>
      </div>

      <div class="ask-me__expert-panel">
        <div class="ask-me__expert-image-wrapper">
          {%- if expert_image != blank -%}
            <img
              class="ask-me__expert-image"
              src="{{ expert_image | image_url: width: 144 }}"
              alt="{{ expert_image.alt | escape }}"
              width="72"
              height="72"
              loading="lazy"
            >
          {%- endif -%}
          <span class="ask-me__expert-badge" aria-hidden="true">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.8 1.6L3.2 5.2L1.2 3.2L0.4 4L3.2 6.8L7.6 2.4L6.8 1.6Z" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="0.5"/>
            </svg>
          </span>
        </div>

        <div class="ask-me__expert-text">
          {%- if expert_title != blank -%}
            <p class="ask-me__expert-title">{{ expert_title | escape }}</p>
          {%- endif -%}
          {%- if expert_description != blank -%}
            <p class="ask-me__expert-description">{{ expert_description | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
.ask-me {
  padding-block-start: var(--padding-block-start);
  padding-block-end: var(--padding-block-end);
}

.ask-me__wrapper {
  padding-inline: 12px;
}

.ask-me__container {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-radius: 16px;
  overflow: hidden;
  background-color: #BC0F0F;
}

.ask-me__search-area {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 24px 20px;
}

.ask-me__heading {
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 24px;
  line-height: 32px;
  letter-spacing: 0;
  color: #FFFFFF;
  margin: 0;
  text-align: center;
}

.ask-me__field {
  width: 100%;
}

.ask-me__field-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background-color: #FFFFFF;
  border: 2px solid #F5F5F5;
  border-radius: 24px;
  overflow: hidden;
}

.ask-me__field-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.ask-me__field-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.ask-me__field-input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 14px;
  line-height: 18px;
  color: #767676;
  padding: 0;
}

.ask-me__field-input::placeholder {
  color: #767676;
}

.ask-me__field-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 8px 16px;
  background-color: #000000;
  color: #FFFFFF;
  border: none;
  border-radius: 28px;
  font-family: 'Uniforma', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 16px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  cursor: pointer;
}

.ask-me__field-button:focus-visible {
  outline: 2px solid #FFFFFF;
  outline-offset: 2px;
}

.ask-me__expert-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 16px;
  border-radius: 0 0 16px 16px;
  background: rgba(255, 255, 255, 0.12);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}

.ask-me__expert-image-wrapper {
  position: relative;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
}

.ask-me__expert-image {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}

.ask-me__expert-badge {
  position: absolute;
  bottom: 0;
  right: -4px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: #414141;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
}

.ask-me__expert-badge svg {
  width: 8px;
  height: 8px;
  display: block;
}

.ask-me__expert-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  justify-content: center;
}

.ask-me__expert-title {
  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 14px;
  line-height: 18px;
  color: #FFFFFF;
  margin: 0;
}

.ask-me__expert-description {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 14px;
  line-height: 18px;
  color: #FFFFFF;
  margin: 0;
}

@media screen and (min-width: 750px) {
  .ask-me__wrapper {
    padding-inline: 16px;
  }

  .ask-me__container {
    flex-direction: row;
  }

  .ask-me__search-area {
    flex: 1;
    min-width: 0;
    padding: 28px 40px 32px 40px;
    align-items: center;
  }

  .ask-me__heading {
    font-size: 32px;
    line-height: 40px;
    text-align: left;
    align-self: flex-start;
  }

  .ask-me__field-inner {
    padding: 8px;
    border-radius: 32px;
  }

  .ask-me__field-content {
    padding: 0 8px;
  }

  .ask-me__field-icon {
    width: 28px;
    height: 28px;
  }

  .ask-me__field-input {
    font-size: 16px;
    line-height: 20px;
    color: #414141;
  }

  .ask-me__field-input::placeholder {
    color: #414141;
  }

  .ask-me__expert-panel {
    flex-shrink: 0;
    width: 445px;
    justify-content: flex-start;
    padding: 0 32px;
    border-radius: 0 16px 16px 0;
  }

  .ask-me__expert-image-wrapper {
    width: 72px;
    height: 72px;
  }

  .ask-me__expert-image {
    width: 72px;
    height: 72px;
  }

  .ask-me__expert-badge {
    display: none;
  }

  .ask-me__expert-text {
    gap: 4px;
  }

  .ask-me__expert-title {
    font-size: 16px;
    line-height: 20px;
  }

  .ask-me__expert-description {
    font-size: 16px;
    line-height: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ask_me",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ask me anything about cardiovascular health"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "How does blood flow support energy?"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "GO"
    },
    {
      "type": "url",
      "id": "search_url",
      "label": "Search URL"
    },
    {
      "type": "image_picker",
      "id": "expert_image",
      "label": "Expert image"
    },
    {
      "type": "text",
      "id": "expert_title",
      "label": "Expert title",
      "default": "Approved by experts"
    },
    {
      "type": "text",
      "id": "expert_description",
      "label": "Expert description",
      "default": "Get answers backed by research from Humann's Chief Cardiologist."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.ask_me"
    }
  ]
}
{% endschema %}
