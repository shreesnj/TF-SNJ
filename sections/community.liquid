{%- liquid
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign show_divider = section.settings.show_divider
  assign stat_number = section.settings.stat_number
  assign stat_label = section.settings.stat_label
-%}

<div
  class="community color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="community__wrapper {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    {%- if heading != blank -%}
      <div class="community__heading">
        {{ heading }}
      </div>
    {%- endif -%}

    {%- if subtitle != blank -%}
      <p class="community__subtitle">{{ subtitle | escape }}</p>
    {%- endif -%}

    {%- if show_divider -%}
      <hr class="community__divider">
    {%- endif -%}

    {%- if stat_number != blank or stat_label != blank -%}
      <div class="community__stats">
        {%- if stat_number != blank -%}
          <span class="community__stat-number">{{ stat_number | escape }}</span>
        {%- endif -%}
        {%- if stat_label != blank -%}
          <span class="community__stat-label">{{ stat_label | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="community__grid">
        {%- for block in section.blocks -%}
          <div class="community__card" {{ block.shopify_attributes }}>
            <div class="community__card-image-wrapper">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: block.settings.image.width | image_tag:
                  sizes: '(min-width: 990px) 280px, 175px',
                  widths: '175,280,350,560',
                  loading: 'lazy',
                  class: 'community__card-image',
                  alt: block.settings.username | default: ''
                }}
              {%- else -%}
                <div class="community__card-placeholder"></div>
              {%- endif -%}
              <div class="community__play-button">
                <img src="{{ 'frame-308.svg' | asset_url }}" alt="" width="10" height="13" loading="lazy">
              </div>
            </div>
            {%- if block.settings.username != blank -%}
              <span class="community__card-username">{{ block.settings.username | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.community {
  padding-block-start: var(--padding-block-start);
  padding-block-end: var(--padding-block-end);
}

.community__wrapper {
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  padding-inline: 16px;
}

.community__heading {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 32px;
  line-height: 36px;
  letter-spacing: -1px;
  color: #767676;
  order: 1;
}

.community__heading p {
  margin: 0;
}

.community__heading strong,
.community__heading b {
  font-weight: 700;
}

.community__subtitle {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 18px;
  line-height: 20px;
  color: #767676;
  margin: 0;
  order: 3;
}

.community__divider {
  display: none;
  border: none;
  border-top: 1px solid #D0D0D0;
  margin: 0;
  order: 2;
}

.community__stats {
  display: flex;
  flex-direction: row;
  gap: 8px;
  align-items: center;
  order: 4;
}

.community__stat-number {
  font-family: var(--font-body--family);
  font-weight: 700;
  font-size: 24px;
  line-height: 32px;
  color: #BC0F0F;
}

.community__stat-label {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: -0.5px;
  color: #BC0F0F;
}

.community__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  order: 5;
}

.community__card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
}

.community__card-image-wrapper {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 175 / 265;
}

.community__card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.community__card-placeholder {
  width: 100%;
  height: 100%;
  background: #E0E0E0;
}

.community__play-button {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 46px;
  height: 45px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.community__play-button img {
  display: block;
}

.community__card-username {
  text-align: center;
  font-family: var(--font-accent--family);
  font-size: 18px;
  line-height: 25px;
  font-weight: 400;
  color: #767676;
}

/* Desktop styles */
@media screen and (min-width: 990px) {
  .community__wrapper {
    padding-inline: 120px;
  }

  .community__heading {
    font-size: 48px;
    line-height: 52px;
    order: 1;
  }

  .community__subtitle {
    font-size: 20px;
    line-height: 24px;
    order: 2;
  }

  .community__divider {
    display: block;
    order: 3;
  }

  .community__stats {
    position: absolute;
    top: 0;
    right: 120px;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    order: unset;
  }

  .community__stat-number {
    font-size: 48px;
    line-height: 52px;
    text-align: center;
  }

  .community__stat-label {
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 0;
    text-align: center;
  }

  .community__grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    order: 4;
  }

  .community__card {
    gap: 5px;
  }

  .community__card-image-wrapper {
    aspect-ratio: 280 / 502;
  }

  .community__play-button {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
}

@supports not (backdrop-filter: blur(8px)) {
  .community__play-button {
    background: rgba(255, 255, 255, 0.4);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.community",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The <strong>Humann community</strong>, in motion.</p>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "More than a product. A community of people focused on feeling better."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "6.5K"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "Active monthly subscribers"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.community_card",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "username",
          "label": "Username",
          "default": "@username"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.community",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "username": "@velmacan"
          }
        },
        {
          "type": "card",
          "settings": {
            "username": "@reillytris"
          }
        },
        {
          "type": "card",
          "settings": {
            "username": "@_cmfree"
          }
        },
        {
          "type": "card",
          "settings": {
            "username": "@tha_one08"
          }
        }
      ]
    }
  ]
}
{% endschema %}
