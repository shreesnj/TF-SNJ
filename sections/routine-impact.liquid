{%- liquid
  assign heading = section.settings.heading
  assign stat_text = section.settings.stat_text
  assign dot_color = section.settings.dot_color
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image
-%}

<div
  class="routine-impact color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if image != blank -%}
    <div class="routine-impact__bg">
      {%- if mobile_image != blank -%}
        <picture>
          <source
            media="(max-width: 989px)"
            srcset="{{ mobile_image | image_url: width: mobile_image.width }}"
          >
          {{ image | image_url: width: image.width | image_tag:
            sizes: '100vw',
            widths: '375,550,750,1100,1500,1780,2000',
            loading: 'lazy',
            alt: image.alt | default: ''
          }}
        </picture>
      {%- else -%}
        {{ image | image_url: width: image.width | image_tag:
          sizes: '100vw',
          widths: '375,550,750,1100,1500,1780,2000',
          loading: 'lazy',
          alt: image.alt | default: ''
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="routine-impact__overlay"></div>

  <div class="routine-impact__wrapper {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="routine-impact__header">
      {%- if heading != blank -%}
        <div class="routine-impact__heading">
          {{ heading }}
        </div>
      {%- endif -%}

      {%- if stat_text != blank -%}
        <div class="routine-impact__stat-row">
          <span class="routine-impact__dot" style="background-color: {{ dot_color }};"></span>
          <span class="routine-impact__stat-text">{{ stat_text | escape }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="routine-impact__cards">
        {%- for block in section.blocks -%}
          <div class="routine-impact__card" {{ block.shopify_attributes }}>
            <div class="routine-impact__card-top">
              {%- if block.settings.label != blank -%}
                <span class="routine-impact__card-label">{{ block.settings.label | escape }}</span>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="routine-impact__card-description">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}
            </div>

            <div class="routine-impact__card-benefits">
              {%- if block.settings.benefit_1 != blank -%}
                <span class="routine-impact__card-benefit">{{ block.settings.benefit_1 | escape }}</span>
              {%- endif -%}
              {%- if block.settings.benefit_2 != blank -%}
                <span class="routine-impact__card-benefit">{{ block.settings.benefit_2 | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.routine-impact {
  position: relative;
  overflow: hidden;
  padding-block-start: var(--padding-block-start);
  padding-block-end: var(--padding-block-end);
}

.routine-impact__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.routine-impact__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.routine-impact__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.2);
  z-index: 1;
}

.routine-impact__wrapper {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
  padding-inline: 12px;
  justify-content: center;
  align-items: center;
}

.routine-impact__header {
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
  padding: 0 8px;
}

.routine-impact__heading {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 48px;
  line-height: 48px;
  letter-spacing: -1px;
  color: #FFFFFF;
}

.routine-impact__heading p {
  margin: 0;
}

.routine-impact__heading strong,
.routine-impact__heading b {
  font-weight: 700;
}

.routine-impact__stat-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.routine-impact__dot {
  width: 12px;
  height: 12px;
  min-width: 12px;
  border-radius: 50%;
  display: inline-block;
}

.routine-impact__stat-text {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 18px;
  line-height: 20px;
  color: #FFFFFF;
}

.routine-impact__cards {
  display: flex;
  flex-direction: row;
  gap: 12px;
  padding-block: 16px;
  width: 100%;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.routine-impact__cards::-webkit-scrollbar {
  display: none;
}

.routine-impact__card {
  min-width: 280px;
  flex-shrink: 0;
  scroll-snap-align: start;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(36px);
  -webkit-backdrop-filter: blur(36px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 20px 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 48px;
}

@supports not (backdrop-filter: blur(36px)) {
  .routine-impact__card {
    background: rgba(30, 30, 30, 0.85);
  }
}

.routine-impact__card-top {
  display: flex;
  flex-direction: column;
  gap: 48px;
}

.routine-impact__card-label {
  font-family: 'Uniforma', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 18px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #FFFFFF;
}

.routine-impact__card-description {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 20px;
  line-height: 24px;
  letter-spacing: -1px;
  color: #FFFFFF;
}

.routine-impact__card-description p {
  margin: 0;
}

.routine-impact__card-description strong,
.routine-impact__card-description b {
  font-weight: 700;
}

.routine-impact__card-benefits {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.routine-impact__card-benefit {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 16px;
  line-height: 20px;
  letter-spacing: -0.5px;
  color: #FFFFFF;
}

/* Desktop styles */
@media screen and (min-width: 990px) {
  .routine-impact__wrapper {
    padding-inline: 120px;
  }

  .routine-impact__header {
    gap: 20px;
  }

  .routine-impact__heading {
    line-height: 60px;
  }

  .routine-impact__stat-text {
    font-size: 20px;
    line-height: 24px;
  }

  .routine-impact__cards {
    gap: 24px;
    overflow-x: visible;
    scroll-snap-type: none;
  }

  .routine-impact__card {
    flex: 1;
    min-width: 0;
  }

  .routine-impact__card-label {
    font-size: 18px;
    line-height: 20px;
  }

  .routine-impact__card-description {
    font-size: 24px;
    line-height: 28px;
  }

  .routine-impact__card-benefit {
    font-size: 18px;
    line-height: 24px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.routine_impact",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>One routine.<br><strong>Big impact.</strong></p>"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "Stat text",
      "default": "35K daily active users"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#BC0F0F"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.routine_impact_card",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "30 DAYS"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>You start building consistency as your routine becomes a part of your <strong>daily cardiovascular support.</strong></p>"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1",
          "default": "Supports nitric oxide levels"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2",
          "default": "Promotes healthy blood flow"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.routine_impact",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "30 DAYS",
            "description": "<p>You start building consistency as your routine becomes a part of your <strong>daily cardiovascular support.</strong></p>",
            "benefit_1": "Supports nitric oxide levels",
            "benefit_2": "Promotes healthy blood flow"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "60 DAYS",
            "description": "<p>You feel the routine take hold as you continue <strong>supporting nitric oxide,</strong> blood flow, and overall cardiovascular health.</p>",
            "benefit_1": "Enhanced daily energy",
            "benefit_2": "Supports cardiovascular vitality"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "90 DAYS",
            "description": "<p>Support becomes part of <strong>your daily rhythm</strong>, with habits and benefits working together over time</p>",
            "benefit_1": "Optimized blood pressure",
            "benefit_2": "Long-term cardiovascular support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
