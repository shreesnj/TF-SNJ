{%- liquid
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign link_text = section.settings.link_text
  assign link_url = section.settings.link_url
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign usa_bar_label = section.settings.usa_bar_label
  assign usa_bar_subtitle = section.settings.usa_bar_subtitle
  assign mobile_max_cards = section.settings.mobile_max_cards | default: 6
-%}

<div
  class="ingredients color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="ingredients__wrapper {% if section.settings.section_width == 'page-width' %}page-width{% endif %}">
    <div class="ingredients__content">
      {%- if heading != blank -%}
        <div class="ingredients__heading">
          {{ heading }}
        </div>
      {%- endif -%}

      <div class="ingredients__subtitle-area">
        {%- if subtitle != blank -%}
          <div class="ingredients__subtitle">
            {{ subtitle }}
            {%- if link_text != blank and link_url != blank -%}
              <a href="{{ link_url }}" class="ingredients__link">{{ link_text | escape }}</a>
            {%- elsif link_text != blank -%}
              <span class="ingredients__link">{{ link_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ingredients__usa-bar">
        <div class="ingredients__usa-bar-left">
          <img src="{{ 'flag.svg' | asset_url }}" alt="" width="27" height="17" loading="lazy">
          <span class="ingredients__usa-bar-label">{{ usa_bar_label | escape }}</span>
        </div>
        <span class="ingredients__usa-bar-subtitle">{{ usa_bar_subtitle | escape }}</span>
      </div>

      <div class="ingredients__cta ingredients__cta--desktop">
        {%- if button_text != blank -%}
          <a
            class="ingredients__button"
            {%- if button_url != blank %}
              href="{{ button_url }}"
            {%- endif %}
          >
            {{ button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="ingredients__grid">
      {%- for block in section.blocks -%}
        <div
          class="ingredients__card{% if forloop.index > mobile_max_cards %} ingredients__card--desktop-only{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 400
              | image_tag:
                loading: 'lazy',
                alt: block.settings.label,
                class: 'ingredients__card-image',
                sizes: '(min-width: 990px) 190px, 50vw',
                widths: '177,185,354,370,400'
            }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <div class="ingredients__card-label-wrapper">
              <span class="ingredients__card-label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="ingredients__cta ingredients__cta--mobile">
      {%- if button_text != blank -%}
        <a
          class="ingredients__button"
          {%- if button_url != blank %}
            href="{{ button_url }}"
          {%- endif %}
        >
          {{ button_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.ingredients {
  padding-block-start: var(--padding-block-start);
  padding-block-end: var(--padding-block-end);
}

.ingredients__wrapper {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.ingredients__content {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.ingredients__heading {
  font-family: var(--font-accent--family);
  font-weight: 400;
  font-size: 32px;
  line-height: 36px;
  letter-spacing: -1px;
  color: #767676;
}

.ingredients__heading p {
  margin: 0;
}

.ingredients__heading strong,
.ingredients__heading b {
  color: #1A1A1A;
}

.ingredients__subtitle-area {
  display: none;
  border-top: 1px solid #D9D9DB;
  border-bottom: 1px solid #D9D9DB;
  padding-block: 20px;
}

.ingredients__subtitle {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 20px;
  line-height: 24px;
  color: #767676;
}

.ingredients__subtitle p {
  margin: 0;
  display: inline;
}

.ingredients__link {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 20px;
  line-height: 24px;
  color: #767676;
  text-decoration: underline;
}

.ingredients__usa-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 34px;
  padding-block: 12px;
  border-top: 1px solid #D9D9DB;
  border-bottom: 1px solid #D9D9DB;
}

.ingredients__usa-bar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 13px;
  padding-inline: 8px;
}

.ingredients__usa-bar-left img {
  width: 27px;
  height: 17px;
  object-fit: contain;
}

.ingredients__usa-bar-label {
  font-family: 'Uniforma', sans-serif;
  font-weight: 400;
  font-size: 12px;
  line-height: 14px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #767676;
}

.ingredients__usa-bar-subtitle {
  font-family: var(--font-body--family);
  font-weight: 500;
  font-size: 14px;
  line-height: 18px;
  color: #767676;
  text-align: center;
}

.ingredients__cta--desktop {
  display: none;
}

.ingredients__cta--mobile {
  display: flex;
  justify-content: center;
}

.ingredients__button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  font-family: 'Uniforma', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 14px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #000000;
  text-decoration: none;
  border: 2px solid #000000;
  border-radius: 28px;
  padding: 12px 20px;
  background: transparent;
  cursor: pointer;
  width: 100%;
}

.ingredients__button:hover {
  background-color: #000000;
  color: #FFFFFF;
}

.ingredients__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  overflow: hidden;
  padding: 8px 12px;
}

.ingredients__card {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  aspect-ratio: 185 / 200;
}

.ingredients__card-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ingredients__card-label-wrapper {
  position: absolute;
  bottom: 0;
  inset-inline: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 16px;
}

.ingredients__card-label {
  font-family: 'Uniforma', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 14px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  text-align: center;
  color: #FFFFFF;
}

/* Desktop styles */
@media screen and (min-width: 990px) {
  .ingredients__wrapper {
    flex-direction: row;
    gap: 60px;
    align-items: center;
  }

  .ingredients__content {
    flex: 0 0 calc(50% - 30px);
    max-width: 570px;
  }

  .ingredients__heading {
    font-size: 48px;
    line-height: 52px;
  }

  .ingredients__subtitle-area {
    display: block;
  }

  .ingredients__usa-bar {
    display: none;
  }

  .ingredients__cta--desktop {
    display: block;
    padding-block: 16px;
  }

  .ingredients__cta--mobile {
    display: none;
  }

  .ingredients__button {
    font-size: 16px;
    line-height: 16px;
    width: auto;
  }

  .ingredients__grid {
    flex: 0 0 calc(50% - 30px);
    max-width: 570px;
    grid-template-columns: repeat(3, 1fr);
    padding: 0;
  }

  .ingredients__card-label {
    font-size: 16px;
    line-height: 16px;
  }
}

@media screen and (max-width: 989px) {
  .ingredients__card--desktop-only {
    display: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ingredients",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Made from clinically researched and <strong>sustainably sourced ingredients.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Made in the USA with carefully sourced ingredients from around the world. From source to formula, each ingredient is chosen with purpose.</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "About ingredients."
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOW ALL INGREDIENTS"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text",
      "id": "usa_bar_label",
      "label": "USA bar label",
      "default": "MADE IN USA"
    },
    {
      "type": "text",
      "id": "usa_bar_subtitle",
      "label": "USA bar subtitle",
      "default": "with globally sourced ingredients"
    },
    {
      "type": "number",
      "id": "mobile_max_cards",
      "label": "Mobile max cards",
      "default": 6
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 96,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:names.ingredients_card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Ingredient"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.ingredients"
    }
  ]
}
{% endschema %}
