{% doc %}
  Star Rating Icons

  Renders inline SVG star icons for a given rating value.

  @param {Number} rating - Rating value (e.g. 4.5) (required)
  @param {String} color - Fill color hex (default: '#BC0F0F')
  @param {Number} size - Icon size in px (default: 20)
  @param {String} half_variant - Half star style: 'left' or 'alt' (default: 'left')

  @example
  {% render 'star-rating-icons', rating: 4.5, color: '#BC0F0F', size: 20, half_variant: 'left' %}
{% enddoc %}

{%- liquid
  assign rating = rating | default: 5
  assign color = color | default: '#BC0F0F'
  assign size = size | default: 20
  assign half_variant = half_variant | default: 'left'

  assign full_stars = rating | floor
  assign remainder = rating | minus: full_stars
  assign has_half = false
  if remainder >= 0.25
    assign has_half = true
  endif
-%}

<span class="star-rating-icons" aria-label="{{ rating }} out of 5 stars" role="img">
  {%- for i in (1..5) -%}
    {%- if i <= full_stars -%}
      <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M18.9609 7.8418L12.6035 7.17041L10.001 1.33301L7.39844 7.17041L1.04102 7.8418L5.78955 12.1216L4.46387 18.374L10.001 15.1807L15.5381 18.374L14.2124 12.1216L18.9609 7.8418Z" fill="{{ color }}"/>
      </svg>
    {%- elsif has_half and i == full_stars | plus: 1 -%}
      {%- if half_variant == 'alt' -%}
        <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 1.48438L9.43359 2.75391L7.40234 7.32422L2.44141 7.83203L1.03516 7.98828L2.08984 8.92578L5.78125 12.2656L4.74609 17.1484L4.45312 18.5156H4.47266L5.68359 17.8125L10 15.332L14.3164 17.8125L15.5469 18.5156L15.2539 17.1484L14.2188 12.2656L17.9102 8.92578L18.9648 7.98828L17.5586 7.83203L12.5977 7.32422L10.5664 2.75391L10 1.48438ZM10 4.55078L11.6016 8.16406L11.7578 8.47656L12.1094 8.51562L16.0547 8.92578L13.1055 11.582L12.832 11.8164L12.9102 12.168L13.7305 16.0352L10.3125 14.0625L10 13.8867V4.55078Z" fill="{{ color }}"/>
        </svg>
      {%- else -%}
        <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10.001 1.33301L7.39844 7.17041L1.04102 7.8418L5.78955 12.1216L4.46387 18.374L10.001 15.1807V1.33301Z" fill="{{ color }}"/>
        </svg>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</span>
